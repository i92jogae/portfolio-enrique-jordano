---
import ExperienceItem from "./ExperienceItem.astro"
import ReactIcon from "../icons/React.astro"
import JavaScriptIcon from "../icons/JavaScript.astro"
import HTMLIcon from "../icons/HTML.astro"
import CSSIcon from "../icons/CSS.astro"
import TailwindCSSIcon from "../icons/Tailwind_CSS.astro"
import JestIcon from "../icons/Jest.astro"
import SonarQubeIcon from "../icons/SonarQube.astro"
import GitIcon from "../icons/Git.astro"
import GitlabIcon from "../icons/Gitlab.astro"
import JiraIcon from "../icons/Jira.astro"
import ReduxIcon from "../icons/Redux.astro"
import AWSIcon from "../icons/AWS.astro"
import AzureIcon from "../icons/Azure.astro"

const EXPERIENCE = [
  {
    date: 'Junio 2024 - Junio 2026',
    title: 'Junior Frontend Engineer',
    company: 'NTT DATA',
    description: 'Participé en la implantación y evolución de un sistema software para el servicio de emergencias 112 de Andalucía, colaborando en desarrollo frontend, integración de servicios y validación funcional.',
    descriptionPoints: [
      'Desarrollo de interfaces dinámicas, responsive y reutilizables con React, JavaScript, HTML, CSS y Tailwind CSS.',
      'Gestión de estado y lógica reutilizable mediante hooks, useContext, Redux, custom hooks y useReducer.',
      'Integración y validación de APIs REST junto al equipo backend, utilizando Oracle y DBeaver para consultas y comprobación de datos.',
      'Optimización de búsquedas, renderizado y carga de componentes mediante debounce, useMemo, useCallback y lazy loading.',
      'Desarrollo de pruebas con Jest y Vitest y revisión de calidad de código mediante SonarQube.',
      'Trabajo colaborativo con Git, GitLab y Jira, además de apoyo en despliegues y seguimiento de incidencias en Azure.'
    ],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'JavaScript', icon: JavaScriptIcon },
      { name: 'HTML', icon: HTMLIcon },
      { name: 'CSS', icon: CSSIcon },
      { name: 'Tailwind CSS', icon: TailwindCSSIcon },
      { name: 'Redux', icon: ReduxIcon },
      { name: 'Jest / Vitest', icon: JestIcon },
      { name: 'SonarQube', icon: SonarQubeIcon },
      { name: 'Git', icon: GitIcon },
      { name: 'GitLab', icon: GitlabIcon },
      { name: 'Jira', icon: JiraIcon },
      { name: 'Azure', icon: AzureIcon },
    ],
  },
  {
    date: 'Abril 2023 - Mayo 2024',
    title: 'Fullstack Developer Intern',
    company: 'Konecta',
    description: 'Desarrollé en equipo una plataforma web corporativa para la gestión vacacional de empleados, implementando soluciones escalables y reutilizables en el front-end y una arquitectura robusta en el back-end.',
    descriptionPoints: [
      'Creación de interfaces modulares con React, JavaScript, HTML y Tailwind CSS.',
      'Implementación de microservicios serverless con JavaScript y AWS Lambda siguiendo arquitectura hexagonal.',
      'Desarrollo de pruebas unitarias con Jest y Enzyme para mejorar fiabilidad del código.',
      'Trabajo con metodologías ágiles, planificación de sprints y gestión de tareas con Jira.',
      'Control de versiones con Git y Fork siguiendo flujos de trabajo por ramas.'
    ],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'JavaScript', icon: JavaScriptIcon },
      { name: 'HTML', icon: HTMLIcon },
      { name: 'Tailwind CSS', icon: TailwindCSSIcon },
      { name: 'AWS', icon: AWSIcon },
      { name: 'Jest / Enzyme', icon: JestIcon },
      { name: 'Git / Fork', icon: GitIcon },
      { name: 'Jira', icon: JiraIcon },
    ]
  }
]
---

<ol class="relative border-s border-white/10 pl-1">        
  {
    EXPERIENCE.map(experience => (
      <li class="mb-10 ms-5 last:mb-0"> 
        <ExperienceItem {...experience}/>
      </li> 
    ))
  }          
</ol>
