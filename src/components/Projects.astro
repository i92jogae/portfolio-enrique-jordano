---
import ReactIcon from "../icons/React.astro"
import JavaScriptIcon from "../icons/JavaScript.astro"
import ExpressJSIcon from "../icons/ExpressJS.astro"
import MySQLIcon from "../icons/MySQL.astro"
import CSSIcon from "../icons/CSS.astro"
import HTMLIcon from "../icons/HTML.astro"
import GitHub2Icon from "../icons/GitHub2.astro"
import DiagonalArrowIcon from "../icons/DiagonalArrow.astro"
import ViteIcon from "../icons/Vite.astro"
import TypeScriptIcon from "../icons/TypeScript.astro"
import ReduxIcon from "../icons/Redux.astro"
import TailwindCSSIcon from "../icons/Tailwind_CSS.astro"
import VitestIcon from "../icons/Vitest.astro"
import NodeJSIcon from "../icons/NodeJS.astro"

const PROJECTS = [
  {
    title: 'DBLearning',
    subtitle: 'Plataforma full stack de aprendizaje de bases de datos con IA',
    description: 'Aplicación full stack orientada a producto para el aprendizaje de bases de datos. Incluye autenticación JWT, chatbot con IA generativa, generación de tests adaptativos, historial de consultas, seguimiento de resultados, panel de administración, persistencia en MySQL y una API Express refactorizada con arquitectura modular, validaciones, manejo centralizado de errores, testing y CI.',
    github: 'https://github.com/i92jogae/TFG',
    demo: '',
    image: '/projects/dblearning.webp',
    featured: true,
    highlights: ['Full stack React + Express', 'OpenAI API', 'JWT Auth', 'MySQL real', 'Arquitectura modular', 'Testing + CI'],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'Express.js', icon: ExpressJSIcon },
      { name: 'Node.js', icon: NodeJSIcon },
      { name: 'JavaScript', icon: JavaScriptIcon },
      { name: 'MySQL', icon: MySQLIcon },
      { name: 'CSS', icon: CSSIcon },
    ],
  },
  {
    title: 'Redux Users Dashboard',
    subtitle: 'Dashboard de usuarios con React, TypeScript, Redux Toolkit y RTK Query',
    description: 'Dashboard frontend para la gestión de usuarios con React, TypeScript, Redux Toolkit y RTK Query. Implementa CRUD completo, estado global tipado con Redux, búsqueda, ordenación, formularios validados, persistencia local, API simulada, caché, optimistic updates, diseño responsive y pipeline de calidad automatizado.',
    github: 'https://github.com/i92jogae/react-crud-redux',
    demo: 'https://redux-users-dashboard.netlify.app/',
    image: '/projects/redux-users-dashboard.webp',
    featured: true,
    highlights: [
      'TypeScript',
      'Redux Toolkit',
      'RTK Query',
      'React Hook Form + Zod',
      'Optimistic updates',
      'Testing + CI/CD',
      'Responsive dashboard'
    ],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'TypeScript', icon: TypeScriptIcon },
      { name: 'Redux Toolkit', icon: ReduxIcon },
      { name: 'RTK Query', icon: ReduxIcon },
      { name: 'Tailwind CSS', icon: TailwindCSSIcon },
      { name: 'Vitest', icon: VitestIcon },
    ],
  },
  {
    title: 'React Movie Search',
    subtitle: 'Buscador de películas con React, custom hooks y OMDb API',
    description: 'Aplicación frontend desplegada en Netlify que consume la OMDb API para buscar películas. Implementa debounce para optimizar peticiones, evita búsquedas duplicadas, ordena resultados, gestiona estados de carga/error/sin resultados y desacopla la UI del contrato de la API mediante una capa de servicio.',
    github: 'https://github.com/i92jogae/react-movie-search',
    demo: 'https://reactmoviessearch.netlify.app',
    image: '/projects/movie-search.webp',
    featured: false,
    highlights: ['Custom hooks', 'Debounce', 'API REST', 'useMemo/useCallback', 'Responsive UI'],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'Vite', icon: ViteIcon },
      { name: 'JavaScript', icon: JavaScriptIcon },
      { name: 'HTML', icon: HTMLIcon },
      { name: 'CSS', icon: CSSIcon },
    ],
  },
  {
    title: 'Shopping Cart',
    subtitle: 'E-commerce con gestión de estado avanzada en React',
    description: 'E-commerce con integración a DummyJSON API. Implementa useContext + useReducer para una gestión de estado predecible, custom hooks reutilizables, persistencia en localStorage, filtros, arquitectura modular, interfaz responsive y animaciones fluidas.',
    github: 'https://github.com/i92jogae/react-shopping-cart',
    demo: 'https://reactshoppingcart1.netlify.app/',
    image: '/projects/shopping-cart.webp',
    featured: false,
    highlights: ['useReducer', 'Context API', 'localStorage', 'Custom hooks', 'REST API'],
    tags: [
      { name: 'React', icon: ReactIcon },
      { name: 'Vite', icon: ViteIcon },
      { name: 'JavaScript', icon: JavaScriptIcon },
      { name: 'HTML', icon: HTMLIcon },
      { name: 'CSS', icon: CSSIcon },
    ],
  },
]
---

<div class="grid gap-7">
  {
    PROJECTS.map(({ image, title, subtitle, github, demo, description, tags, highlights, featured }) => (
      <article class={`group relative overflow-hidden rounded-3xl border border-cyan-900/10 bg-white/80 shadow-[0_18px_55px_rgba(8,145,178,0.14)] backdrop-blur transition duration-500 hover:-translate-y-1 hover:border-cyan-500/40 hover:bg-white/90 hover:shadow-[0_22px_62px_rgba(6,182,212,0.22)] dark:border-cyan-200/10 dark:bg-white/[0.055] dark:shadow-[0_20px_55px_rgba(0,0,0,0.2)] dark:hover:border-cyan-300/40 dark:hover:bg-white/[0.075] dark:hover:shadow-[0_0_42px_rgba(34,211,238,0.14)] md:grid md:grid-cols-[1.05fr_0.95fr]`}>
        <div class="absolute inset-0 bg-gradient-to-br from-cyan-400/10 via-transparent to-blue-400/5 opacity-0 transition duration-500 group-hover:opacity-100 dark:from-cyan-300/10 dark:to-blue-500/5"></div>

        <div class="relative flex flex-col justify-between p-6 md:p-7">
          <div>
            <div class="mb-4 flex flex-wrap items-center gap-2">
              {featured && (
                <span class="rounded-full border border-cyan-600/25 bg-cyan-50 px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-cyan-800 dark:border-cyan-300/30 dark:bg-cyan-300/10 dark:text-cyan-200">
                  Featured
                </span>
              )}
              {demo && (
                <span class="rounded-full border border-emerald-500/25 bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700 dark:border-emerald-300/25 dark:bg-emerald-300/10 dark:text-emerald-200">
                  Live demo
                </span>
              )}
            </div>

            <h3 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white md:text-3xl">{title}</h3>
            <p class="mt-2 text-sm font-semibold text-cyan-700 dark:text-cyan-200 md:text-base">{subtitle}</p>
            <p class="mt-4 text-pretty text-sm leading-relaxed text-slate-700 dark:text-white/75 md:text-base">{description}</p>

            <ul class="mt-5 flex flex-wrap gap-2">
              {highlights.map((highlight) => (
                <li class="rounded-full border border-cyan-900/10 bg-sky-50/90 px-3 py-1 text-xs font-medium text-slate-700 dark:border-white/10 dark:bg-white/[0.06] dark:text-white/75">
                  {highlight}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-6 flex flex-col gap-5">
            <ul class="flex flex-wrap gap-2">
              {tags.map(tag => (
                <li>
                  <span class="inline-flex items-center gap-x-2 rounded-xl border border-cyan-900/10 bg-white/80 px-2.5 py-1.5 text-xs font-medium text-slate-800 shadow-[0_3px_12px_rgba(8,145,178,0.08)] dark:border-white/10 dark:bg-slate-950/40 dark:text-white/80 md:text-sm">
                    <tag.icon class="size-5 text-cyan-700 dark:text-cyan-200 md:size-6" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="flex flex-wrap items-center gap-3">
              {demo && (
                <a href={demo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-cyan-500/25 bg-gradient-to-r from-cyan-500 to-blue-500 px-4 py-2 text-sm font-bold text-white shadow-[0_8px_24px_rgba(6,182,212,0.24)] transition hover:-translate-y-0.5 hover:from-cyan-400 hover:to-blue-400 dark:border-cyan-300/30 dark:from-cyan-300 dark:to-blue-500 dark:text-slate-950 dark:shadow-[0_0_20px_rgba(34,211,238,0.18)]">
                  Ver demo
                  <DiagonalArrowIcon class="size-3.5" />
                </a>
              )}
              <a href={github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-xl border border-cyan-900/20 bg-white/60 px-4 py-2 text-sm font-bold text-slate-700 transition hover:-translate-y-0.5 hover:border-cyan-500/40 hover:bg-cyan-50 hover:text-cyan-800 dark:border-white/10 dark:bg-white/[0.06] dark:text-white/90 dark:hover:border-cyan-200/25 dark:hover:bg-white/[0.1] dark:hover:text-white">
                <GitHub2Icon class="size-5" />
                Código
                <DiagonalArrowIcon class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

        <div class="relative min-h-[260px] border-t border-cyan-900/10 bg-gradient-to-br from-sky-50/90 to-cyan-50/70 p-4 dark:border-white/10 dark:from-slate-950/50 dark:to-cyan-950/25 md:border-l md:border-t-0 md:p-5">
          {image ? (
            demo ? (
              <a href={demo} target="_blank" rel="noopener noreferrer" class="block h-full">
                <img class="h-full min-h-[230px] max-h-[540px] w-full rounded-2xl border border-cyan-900/10 object-cover object-top shadow-2xl shadow-cyan-900/20 transition duration-500 group-hover:scale-[1.02] dark:border-white/10 dark:shadow-black/40" src={image} alt={`Captura de pantalla del proyecto ${title}`} />
              </a>
            ) : (
              <img class="h-full min-h-[230px] max-h-[540px] w-full rounded-2xl border border-cyan-900/10 object-cover object-top shadow-2xl shadow-cyan-900/20 transition duration-500 group-hover:scale-[1.02] dark:border-white/10 dark:shadow-black/40" src={image} alt={`Captura de pantalla del proyecto ${title}`} />
            )
          ) : (
            <a href={demo} target="_blank" rel="noopener noreferrer" class="flex h-full min-h-[260px] items-center justify-center rounded-2xl border border-white/10 bg-gradient-to-br from-sky-200 via-white to-blue-100 p-5 shadow-2xl shadow-black/30 transition duration-500 group-hover:scale-[1.02]">
              <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-4 text-slate-950 shadow-2xl">
                <div class="mb-4 flex items-center gap-2 border-b border-slate-100 pb-3">
                  <span class="size-3 rounded-full bg-red-400"></span>
                  <span class="size-3 rounded-full bg-amber-400"></span>
                  <span class="size-3 rounded-full bg-emerald-400"></span>
                  <span class="ml-auto rounded-full bg-slate-100 px-3 py-1 text-[10px] font-semibold text-slate-500">OMDb API</span>
                </div>
                <div class="mb-4 rounded-xl bg-slate-50 p-4 text-center">
                  <p class="text-xs font-bold uppercase tracking-[0.22em] text-blue-600">React Movie Search</p>
                  <p class="mt-2 text-2xl font-black tracking-tight">Find your next movie</p>
                </div>
                <div class="grid grid-cols-3 gap-3">
                  {[1, 2, 3].map(() => (
                    <div class="overflow-hidden rounded-xl bg-slate-100">
                      <div class="aspect-[2/3] bg-gradient-to-br from-blue-200 to-slate-200"></div>
                      <div class="space-y-1 p-2">
                        <div class="h-2 rounded bg-slate-300"></div>
                        <div class="h-2 w-2/3 rounded bg-slate-200"></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </a>
          )}
        </div>
      </article>
    ))
  }
</div>
