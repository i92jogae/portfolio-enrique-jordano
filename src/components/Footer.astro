---
import CopyrightIcon from "../icons/Copyright.astro";
import DiagonalArrowIcon from "../icons/DiagonalArrow.astro";
import GitHub2Icon from "../icons/GitHub2.astro";
import LinkedIn2Icon from "../icons/LinkedIn2.astro";
import Mail2Icon from "../icons/Mail2.astro";
---

<footer class="w-full px-4 py-9 md:pb-10 md:pt-11">
  <div class="mx-auto flex w-full max-w-screen-xl flex-col items-center gap-y-6 border-t border-white/10 pt-8 md:flex-row md:justify-between">
    <span class="flex flex-row items-center gap-1 text-sm text-white/55 md:text-base">
      <CopyrightIcon class="size-4 md:size-5" />
      2026 - 
      <a href="#top" class="hover:text-sky-400 hover:underline"> 
        Enrique Jordano 
      </a>
      - All Rights Reserved
    </span>
    <ul class="mt-3 flex flex-wrap items-center gap-6 text-sm font-medium text-white/60 sm:mt-0 md:text-base">
      <li>
        <a href="https://www.linkedin.com/in/enrique-jordano-garcía" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center gap-1 transition hover:text-sky-400 hover:underline">
          <LinkedIn2Icon class="size-7 md:size-8" />
          LinkedIn
          <DiagonalArrowIcon class="size-3 self-start md:size-4" />
        </a>
      </li>
      <li>
        <a href="https://github.com/i92jogae" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center gap-1 transition hover:text-sky-400 hover:underline">
          <GitHub2Icon class="size-6 stroke-[2] md:size-7" />
          GitHub
          <DiagonalArrowIcon class="size-3 self-start md:size-4" />
        </a>
      </li>
      <li>
        <a href="mailto:enriquejordanogarcia@gmail.com" target="_blank" rel="noopener noreferrer" class="flex flex-row items-center gap-1 transition hover:text-sky-400 hover:underline">
          <Mail2Icon class="size-6 md:size-7" />
          Email
          <DiagonalArrowIcon class="size-3 self-start md:size-4" />
        </a>
      </li>
    </ul>
  </div>
</footer>
