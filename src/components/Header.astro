---
import LogoIcon from "../icons/Logo.astro";
import Mail2 from "../icons/Mail2.astro";
import Person from "../icons/Person.astro";
const navItems = [
  { title: "Experiencia", label: "experiencia", url: "/#experiencia" },
  { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
  { title: "Tech Stack", label: "tech-stack", url: "/#tech-stack" },
  { title: "Sobre mí", icon: Person, label: "sobre-mi", url: "/#sobre-mi" },
  { title: "Contacto", icon: Mail2, label: "contacto", url: "/#contacto" },
]
---

<header class="fixed left-0 top-0 z-50 flex w-full items-center justify-center border-b border-white/10 bg-slate-950/60 px-4 py-3 shadow-lg shadow-black/10 backdrop-blur-xl md:justify-between md:px-8 md:py-4">
  <a href="/#top" class="hidden transition duration-300 hover:scale-110 md:block" aria-label="Ir al inicio">
    <LogoIcon />
  </a>
  <nav class="flex flex-row items-center gap-x-4 rounded-full bg-white/[0.04] px-4 text-[13px] font-semibold text-white/85 shadow-xl shadow-black/10 sm:gap-x-8 sm:text-base md:bg-transparent md:shadow-none">
    {
      navItems.map(item => (
        item.icon ? (
          <a class="relative py-2 transition duration-300 hover:-translate-y-0.5 hover:text-sky-400 before:absolute before:bottom-0 before:left-0 before:h-[2px] before:w-full before:origin-left before:scale-x-0 before:bg-sky-400 before:transition-transform before:duration-300 hover:before:scale-x-100" href={item.url} aria-label={item.label}>
            <item.icon class="size-6 stroke-[1.5] sm:hidden" />
            <span class="hidden sm:inline">{item.title}</span>
          </a>
        ) : item.title === "Tech Stack" ? (
          <a class="relative hidden py-2 transition duration-300 hover:-translate-y-0.5 hover:text-sky-400 before:absolute before:bottom-0 before:left-0 before:h-[2px] before:w-full before:origin-left before:scale-x-0 before:bg-sky-400 before:transition-transform before:duration-300 hover:before:scale-x-100 sm:inline" href={item.url} aria-label={item.label}>
            <span>{item.title}</span>
          </a>
        ) : (
          <a class="relative py-2 transition duration-300 hover:-translate-y-0.5 hover:text-sky-400 before:absolute before:bottom-0 before:left-0 before:h-[2px] before:w-full before:origin-left before:scale-x-0 before:bg-sky-400 before:transition-transform before:duration-300 hover:before:scale-x-100" href={item.url} aria-label={item.label}>
            <span>{item.title}</span>
          </a>
        )
      ))
    }
  </nav>
</header>
