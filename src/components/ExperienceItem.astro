---
interface Props {
  title: string
  company: string
  description: string
  descriptionPoints: string[] 
  link?: string
  date: string
}
const { title, company, description, descriptionPoints, link, date} = Astro.props
---

<div class="absolute -start-1.5 mt-8 size-3 rounded-full border border-sky-200 bg-sky-300 shadow-lg shadow-sky-400/40"></div>
<div class="grid gap-4 rounded-3xl border border-white/10 bg-white/[0.045] p-5 shadow-xl shadow-black/10 backdrop-blur transition duration-300 hover:border-sky-300/30 hover:bg-white/[0.065] md:grid-cols-3 md:gap-6 md:p-6">
  <div>
    <h3 class="text-lg font-bold text-sky-200">
      {title}
    </h3>
    <h4 class="mt-1 text-base font-semibold text-white">
      {company}
    </h4>
    <time class="mt-2 block text-xs font-medium leading-none text-white/50 md:text-sm">
      {date}
    </time>
  </div>

  <div class="md:col-span-2">
    <p class="mb-4 text-pretty text-sm leading-relaxed text-white/75 md:text-base">
      {description}
    </p>
    <ul class="space-y-2">
      {descriptionPoints.map((point) => (
        <li class="flex gap-2 text-sm leading-relaxed text-white/70 md:text-base">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-sky-300"></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    {
      link && (
        <a href={link} class="mt-5 inline-flex items-center rounded-xl border border-white/10 bg-white/[0.06] px-4 py-2 text-sm font-bold text-white/90 transition hover:border-sky-300/40 hover:bg-sky-400/10 hover:text-sky-200">
          Saber más...
          <svg class="ms-2 size-3 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
          </svg>
        </a>
      )
    }
  </div>
</div>
