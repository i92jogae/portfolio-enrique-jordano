---
interface Props {
  title: string
  company: string
  description: string
  descriptionPoints: string[]
  tags?: Array<{
    name: string
    icon?: any
  }>
  link?: string
  date: string
}
const { title, company, description, descriptionPoints, tags = [], link, date } = Astro.props
---

<div class="absolute -start-1.5 mt-8 size-3 rounded-full border border-cyan-600 bg-cyan-500 shadow-[0_0_14px_rgba(6,182,212,0.55)] dark:border-cyan-200 dark:bg-cyan-300 dark:shadow-[0_0_16px_rgba(103,232,249,0.65)]"></div>
<div class="grid gap-4 rounded-3xl border border-cyan-900/10 bg-white/70 p-5 shadow-[0_16px_46px_rgba(8,145,178,0.09)] backdrop-blur transition duration-300 hover:border-cyan-500/40 hover:bg-white/90 hover:shadow-[0_18px_50px_rgba(6,182,212,0.14)] dark:border-cyan-200/10 dark:bg-white/[0.045] dark:shadow-[0_18px_48px_rgba(0,0,0,0.18)] dark:hover:border-cyan-300/30 dark:hover:bg-white/[0.065] dark:hover:shadow-[0_0_34px_rgba(34,211,238,0.08)] md:grid-cols-3 md:gap-6 md:p-6">
  <div>
    <h3 class="text-lg font-bold text-cyan-700 dark:text-cyan-300">
      {title}
    </h3>
    <h4 class="mt-1 text-base font-semibold text-slate-900 dark:text-white">
      {company}
    </h4>
    <time class="mt-2 block text-xs font-medium leading-none text-slate-500 dark:text-white/50 md:text-sm">
      {date}
    </time>
    <ul class="mt-7 flex flex-wrap  gap-2" aria-label={`Tecnologías utilizadas en ${company}`}>
      {tags.map((tag) => (
        <li>
          <span class="inline-flex items-center gap-x-2 rounded-xl border border-cyan-900/10 bg-sky-50/80 px-2.5 py-1.5 text-xs font-medium text-slate-700 shadow-sm transition hover:border-cyan-500/40 hover:text-cyan-800 dark:border-white/10 dark:bg-slate-950/40 dark:text-white/80 dark:hover:border-cyan-300/40 dark:hover:text-cyan-100 md:text-xs">
            {tag.icon && <tag.icon class="size-5 text-cyan-700 dark:text-cyan-200 md:size-6" />}
            {tag.name}
          </span>
        </li>
      ))}
    </ul>
  </div>

  <div class="md:col-span-2">
    <p class="mb-4 text-pretty text-sm leading-relaxed text-slate-700 dark:text-white/75 md:text-base">
      {description}
    </p>
    <ul class="space-y-2">
      {descriptionPoints.map((point) => (
        <li class="flex gap-2 text-sm leading-relaxed text-slate-600 dark:text-white/70 md:text-base">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-cyan-500 shadow-[0_0_8px_rgba(6,182,212,0.5)] dark:bg-cyan-300"></span>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    {
      link && (
        <a href={link} class="mt-5 inline-flex items-center rounded-xl border border-cyan-900/20 bg-white/60 px-4 py-2 text-sm font-bold text-slate-700 transition hover:border-cyan-500/40 hover:bg-cyan-50 hover:text-cyan-800 dark:border-white/10 dark:bg-white/[0.06] dark:text-white/90 dark:hover:border-cyan-300/40 dark:hover:bg-cyan-400/10 dark:hover:text-cyan-200">
          Saber más...
          <svg class="ms-2 size-3 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9" />
          </svg>
        </a>
      )
    }
  </div>
</div>
