---
import Badge from '../components/Badge.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Layout from '../layouts/Layout.astro';
import LinkedInIcon from '../icons/LinkedIn.astro';
import GitHubIcon from '../icons/GitHub.astro';
import SocialPill from '../components/SocialPill.astro';
import MailIcon from '../icons/Mail.astro';
import Experience from '../components/Experience.astro';
import BuildingIcon from '../icons/Building.astro';
import CodeIcon from '../icons/Code.astro';
import Projects from '../components/Projects.astro';
import IdeaIcon from '../icons/Idea.astro';
import PersonIcon from '../icons/Person.astro';
import AboutMe from '../components/AboutMe.astro';
import ContactIcon from '../icons/Contact.astro';
import Contact from '../components/Contact.astro';
import DownloadIcon from '../icons/Download.astro';
import TechStack from '../components/TechStack.astro';
---

<Layout 
  title="Enrique Jordano García | Frontend Developer React"
  description="Portfolio de Enrique Jordano García, desarrollador frontend especializado en React, JavaScript, Tailwind CSS y aplicaciones web modernas."
>
  <main id="top" class="px-4">
    <SectionContainer class="relative pt-32 md:pt-44 md:pb-24">
      <div class="absolute -left-20 top-28 -z-10 size-72 rounded-full bg-cyan-400/20 blur-3xl dark:bg-cyan-400/20"></div>
      <div class="absolute right-0 top-40 -z-10 size-72 rounded-full bg-blue-400/20 blur-3xl dark:bg-blue-600/20"></div>

      <div class="mb-5 flex flex-row flex-wrap items-center gap-4 lg:mb-7">
        <h1 class="max-w-4xl bg-gradient-to-r from-cyan-700 via-blue-700 to-cyan-600 bg-clip-text text-balance text-4xl font-black tracking-tight text-transparent drop-shadow-[0_0_22px_rgba(6,182,212,0.22)] dark:from-cyan-200 dark:via-blue-400 dark:to-cyan-300 dark:drop-shadow-[0_0_28px_rgba(34,211,238,0.34)] md:text-6xl">
          Enrique Jordano García
        </h1>
        <a class="flex items-center" href="https://www.linkedin.com/in/enrique-jordano-garcía" target="_blank" rel="noopener noreferrer">
          <Badge>Abierto a nuevas oportunidades</Badge>
        </a>
      </div>

      <h2 class="max-w-[820px] text-pretty text-lg leading-relaxed text-slate-700 dark:text-white/80 md:text-xl lg:text-2xl">
        <span class="font-bold text-cyan-700 dark:text-cyan-200">Frontend Developer con +3 años de experiencia.</span>
        <span class="font-semibold text-blue-700 dark:text-blue-300"> Especializado en React, JavaScript y desarrollo de interfaces modernas,</span>
        <span> con foco en buenas prácticas, rendimiento, experiencia de usuario y código mantenible.</span>
      </h2>

      <nav class="mt-8 flex flex-wrap gap-4 md:gap-5">
        <SocialPill href="https://www.linkedin.com/in/enrique-jordano-garcía">
          <LinkedInIcon class="size-4 lg:size-6" />
          LinkedIn
        </SocialPill>
        <SocialPill href="https://github.com/i92jogae">
          <GitHubIcon class="size-4 md:size-6" />
          GitHub
        </SocialPill>
        <SocialPill href="mailto:enriquejordanogarcia@gmail.com">
          <MailIcon class="size-4 lg:size-6" />
          enriquejordanogarcia@gmail.com
        </SocialPill>
      </nav>

      <a
        class="mt-6 inline-flex w-fit flex-row items-center gap-2 rounded-xl border border-cyan-500/20 bg-gradient-to-r from-cyan-500 to-blue-500 px-4 py-3 text-sm font-bold text-white shadow-[0_10px_30px_rgba(6,182,212,0.28)] transition hover:-translate-y-0.5 hover:from-cyan-400 hover:to-blue-400 hover:shadow-[0_12px_34px_rgba(6,182,212,0.38)] dark:border-cyan-300/30 dark:from-cyan-300 dark:to-blue-500 dark:text-slate-950 dark:shadow-[0_0_24px_rgba(34,211,238,0.22)] md:text-base"
        href="https://drive.google.com/file/d/11xZzDgAkJ1kDaSXh6WnWKLSxCur-Qepi/view?usp=sharing"
        target="_blank"
        rel="noopener noreferrer"
      >
        <DownloadIcon class="size-4 md:size-6" />
        Descarga mi CV
      </a>
    </SectionContainer>

    <SectionContainer id="experiencia">
      <h2 class="mb-8 flex items-center gap-x-2 text-3xl font-bold tracking-tight md:text-4xl">
        <BuildingIcon class="size-8 text-cyan-700 drop-shadow-[0_0_10px_rgba(6,182,212,0.28)] dark:text-cyan-200 dark:drop-shadow-[0_0_12px_rgba(34,211,238,0.36)] md:size-9" />
        Experiencia laboral
      </h2>
      <Experience />
    </SectionContainer>

    <SectionContainer id="proyectos">
      <div class="mb-8 flex flex-col gap-3 md:mb-10">
        <h2 class="flex items-center gap-x-2 text-3xl font-bold tracking-tight md:text-4xl">
          <IdeaIcon class="size-8 text-cyan-700 drop-shadow-[0_0_10px_rgba(6,182,212,0.28)] dark:text-cyan-200 dark:drop-shadow-[0_0_12px_rgba(34,211,238,0.36)] md:size-9" />
          Proyectos destacados
        </h2>
        <p class="max-w-3xl text-pretty text-base leading-relaxed text-slate-700 dark:text-white/70 md:text-lg">
          Proyectos desarrollados con React enfocados en arquitectura frontend, integración con APIs, optimización, gestión de estado y UI responsive.
        </p>
      </div>
      <Projects />
    </SectionContainer>

    <SectionContainer id="tech-stack">
      <h2 class="mb-7 flex items-center gap-x-2 text-3xl font-bold tracking-tight md:text-4xl">
        <CodeIcon class="size-8 text-cyan-700 drop-shadow-[0_0_10px_rgba(6,182,212,0.28)] dark:text-cyan-200 dark:drop-shadow-[0_0_12px_rgba(34,211,238,0.36)] md:size-9" />
        Tech stack
      </h2>
      <p class="mb-5 max-w-3xl text-pretty text-base leading-relaxed text-slate-700 dark:text-white/70 md:text-lg">
        Tecnologías y herramientas que utilizo en proyectos personales y experiencia profesional.
      </p>
      <TechStack />
    </SectionContainer>

    <SectionContainer id="sobre-mi" class="md:!max-w-5xl">
      <h2 class="mb-7 flex items-center gap-x-2 text-3xl font-bold tracking-tight md:text-4xl">
        <PersonIcon class="size-8 text-cyan-700 drop-shadow-[0_0_10px_rgba(6,182,212,0.28)] dark:text-cyan-200 dark:drop-shadow-[0_0_12px_rgba(34,211,238,0.36)] md:size-9" />
        Sobre mí
      </h2>
      <AboutMe />
    </SectionContainer>

    <SectionContainer id="contacto" class="pb-20 text-center md:pb-24">
      <h2 class="mb-7 flex flex-col items-center gap-y-4 text-3xl font-bold tracking-tight md:text-4xl">
        <ContactIcon class="size-14 text-cyan-700 drop-shadow-[0_0_12px_rgba(6,182,212,0.30)] dark:text-cyan-200 dark:drop-shadow-[0_0_15px_rgba(34,211,238,0.40)] md:size-16" />
        Contacto
      </h2>
      <Contact />
    </SectionContainer>
  </main>
</Layout>
