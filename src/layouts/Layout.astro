---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import '@fontsource-variable/onest';

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4faff" />
    <script is:inline>
      (() => {
        let savedTheme = null

        try {
          savedTheme = localStorage.getItem('theme')
        } catch {}

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches
        const theme = savedTheme ?? (prefersDark ? 'dark' : 'light')
        const isDark = theme === 'dark'

        document.documentElement.classList.toggle('dark', isDark)
        document.documentElement.style.colorScheme = isDark ? 'dark' : 'light'
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', isDark ? '#020617' : '#f4faff')
      })()
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style is:global>
  html {
    font-family: 'Onest Variable', system-ui, sans-serif;
    scroll-behavior: smooth;
    background: #f4faff;
    scrollbar-color: rgba(8, 145, 178, 0.55) #e7f4fa;
    scrollbar-width: thin;
  }

  html.dark {
    background: #020617;
    scrollbar-color: rgba(103, 232, 249, 0.55) #020617;
  }

  html::-webkit-scrollbar {
    width: 12px;
  }

  html::-webkit-scrollbar-track {
    background: #e7f4fa;
  }

  html.dark::-webkit-scrollbar-track {
    background: #020617;
  }

  html::-webkit-scrollbar-thumb {
    border: 4px solid #e7f4fa;
    border-radius: 999px;
    background: rgba(8, 145, 178, 0.65);
  }

  html.dark::-webkit-scrollbar-thumb {
    border-color: #020617;
    background: rgba(103, 232, 249, 0.6);
  }

  body {
    min-height: 100vh;
    color: #0f172a;
    background:
      radial-gradient(circle at 12% 6%, rgba(34, 211, 238, 0.18), transparent 30rem),
      radial-gradient(circle at 88% 12%, rgba(59, 130, 246, 0.13), transparent 28rem),
      linear-gradient(180deg, #f8fcff 0%, #eef8fc 48%, #f7fbff 100%);
    transition: background-color 300ms ease, color 300ms ease;
  }

  .dark body {
    color: white;
    background:
      radial-gradient(circle at 14% 7%, rgba(34, 211, 238, 0.18), transparent 29rem),
      radial-gradient(circle at 84% 15%, rgba(37, 99, 235, 0.17), transparent 27rem),
      radial-gradient(circle at 58% 72%, rgba(8, 145, 178, 0.08), transparent 34rem),
      linear-gradient(180deg, #020617 0%, #071426 42%, #020617 100%);
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background-image:
      linear-gradient(rgba(8, 145, 178, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8, 145, 178, 0.055) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 80%);
  }

  .dark body::before {
    background-image:
      linear-gradient(rgba(103, 232, 249, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(103, 232, 249, 0.035) 1px, transparent 1px);
  }

  ::selection {
    background: rgba(6, 182, 212, 0.28);
    color: #0f172a;
  }

  .dark ::selection {
    background: rgba(103, 232, 249, 0.32);
    color: white;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
